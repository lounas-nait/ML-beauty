generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Contact {
  id        Int      @id @default(autoincrement())
  phone     String?
  email     String?
  instagram String?
  address   String?
  updatedAt DateTime
}

model Prestation {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Float
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  priceLabel  String?
  icon        String?
  bookingUrl  String?
  isPromo     Boolean  @default(false)
  promoPrice  Float?
  promoLabel  String?
  order       Int      @default(0)
  features    String[] @default([])
}

model Review {
  id            String         @id @default(cuid())
  name          String
  rating        Int
  comment       String?
  platform      ReviewPlatform @default(DIRECT)
  status        ReviewStatus   @default(PENDING)
  source        ReviewSource   @default(CLIENT)
  image         String?
  createdAt     DateTime       @default(now())
  screenshotUrl String?
}

model Realisation {
  id        String             @id @default(cuid())
  title     String
  category  String
  createdAt DateTime           @default(now())
  media     RealisationMedia[]
}

model RealisationMedia {
  id            String      @id @default(cuid())
  realisationId String
  url           String
  type          MediaType   @default(IMAGE)
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  realisation   Realisation @relation(fields: [realisationId], references: [id], onDelete: Cascade)
}

enum ReviewPlatform {
  GOOGLE
  INSTAGRAM
  TIKTOK
  DIRECT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewSource {
  CLIENT
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
}
