# Exemple de variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs

# Base de données (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Secret utilisé pour signer les JWT (générez une valeur aléatoire forte)
JWT_SECRET=your-random-jwt-secret

# Identifiants admin
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=your-secure-password

# Vercel Blob (stockage des photos/vidéos de réalisations)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx


# Contact Info
NEXT_PUBLIC_PHONE=+33612345678
NEXT_PUBLIC_EMAIL=contact@nailsbeauty.com
NEXT_PUBLIC_WHATSAPP=https://wa.me/33612345678
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/mlbeauty_77?igsh=MW5oYXpiOXBneDdrYg==/nails_beauty_paris

# Analytics (optionnel)
# NEXT_PUBLIC_GA_ID=UA-XXXXXXXXX-X
